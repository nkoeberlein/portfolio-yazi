---
/**
 * Linke Pane: das übergeordnete Verzeichnis, der aktuelle Ordner ist markiert.
 * Reine Links ohne Auswahl-Logik — keynav.ts fasst nur `#filelist` an.
 */
import { iconFor } from "../lib/icons";
import type { ParentEntry } from "../lib/panes";

interface Props {
  entries: ParentEntry[];
  /** Pfad des gezeigten Verzeichnisses, z. B. `/home` oder `~` */
  label: string;
}

const { entries, label } = Astro.props;
---

<nav id="parent" class="pane" aria-label={`Parent directory ${label}`}>
  <span class="pane-title" aria-hidden="true"> {label} </span>
  <ul id="parentlist" class="entry-list pane-body">
    {
      entries.map((entry) => (
        <li class:list={[entry.kind, entry.active && "sel"]}>
          <a class="entry" href={entry.href} aria-current={entry.active ? "true" : undefined}>
            <span class="glyph" aria-hidden="true">{iconFor(entry.name)}</span>
            <span class="c-name">{entry.name}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>
