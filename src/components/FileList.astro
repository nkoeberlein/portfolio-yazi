---
/**
 * Middle pane: the file listing. Each entry is a real link (progressive
 * enhancement) and optionally carries a `<template>` with preview content that
 * keynav.ts clones into the right pane upon selection. Date and note are
 * provided as data attributes — keynav.ts renders them into the status bar.
 */
import { iconFor } from "../lib/icons";

export interface EntryVM {
  name: string;
  kind: "dir" | "file";
  href: string;
  note: string;
  size: string;
  date: string;
  /** Server-side preselected (aria-current + .sel) */
  selected: boolean;
  /** Title for the preview pane when this entry is selected */
  previewTitle: string;
  /**
   * HTML for the preview pane (already escaped, rendered via set:html).
   * Empty for an opened file: keynav.ts restores the document on return.
   */
  previewHTML: string;
}

interface Props {
  entries: EntryVM[];
  ariaLabel?: string;
}

const { entries, ariaLabel = "File list" } = Astro.props;
---

<section id="filepanel" class="pane" aria-label={ariaLabel}>
  <span class="pane-title" aria-hidden="true"> ls </span>
  <ul id="filelist" class="entry-list pane-body">
    {
      entries.map((entry) => (
        <li
          class:list={[entry.kind, entry.selected && "sel"]}
          data-name={entry.name}
          data-size={entry.size}
          data-date={entry.date}
          data-note={entry.note}
        >
          <a class="entry" href={entry.href} aria-current={entry.selected ? "page" : undefined}>
            <span class="glyph" aria-hidden="true"><Fragment set:html={iconFor(entry.name)} /></span>
            <span class="c-name">{entry.name}</span>
            <span class="c-size" aria-hidden="true">{entry.size}</span>
          </a>
          {entry.previewHTML && (
            <template data-title={entry.previewTitle}>
              <Fragment set:html={entry.previewHTML} />
            </template>
          )}
        </li>
      ))
    }
  </ul>
</section>
