---
/**
 * Mittlere Pane: die Dateiliste. Jeder Eintrag ist ein echter Link (Progressive
 * Enhancement) und trägt wahlweise ein <template> mit Preview-Inhalt, das
 * keynav.ts beim Auswählen in die rechte Pane kloniert. Datum und Note stehen
 * als data-Attribute bereit — keynav.ts schreibt sie in die Statuszeile.
 */
import { iconFor } from "../lib/icons";

export interface EntryVM {
  name: string;
  kind: "dir" | "file";
  href: string;
  note: string;
  size: string;
  date: string;
  /** Serverseitig vorselektiert (aria-current + .sel) */
  selected: boolean;
  /** Titel für die Preview-Pane, wenn dieser Eintrag gewählt wird */
  previewTitle: string;
  /** HTML für die Preview-Pane (bereits escaped, via set:html gerendert).
   * Leer bei der geöffneten Datei: dort stellt keynav.ts das Dokument wieder her. */
  previewHTML: string;
}

interface Props {
  entries: EntryVM[];
  ariaLabel?: string;
}

const { entries, ariaLabel = "File list" } = Astro.props;
---

<section id="filepanel" class="pane" aria-label={ariaLabel}>
  <span class="pane-title" aria-hidden="true"> ls </span>
  <ul id="filelist" class="entry-list pane-body">
    {
      entries.map((entry) => (
        <li
          class:list={[entry.kind, entry.selected && "sel"]}
          data-name={entry.name}
          data-size={entry.size}
          data-date={entry.date}
          data-note={entry.note}
        >
          <a class="entry" href={entry.href} aria-current={entry.selected ? "page" : undefined}>
            <span class="glyph" aria-hidden="true">{iconFor(entry.name)}</span>
            <span class="c-name">{entry.name}</span>
            <span class="c-size" aria-hidden="true">{entry.size}</span>
          </a>
          {entry.previewHTML && (
            <template data-title={entry.previewTitle}>
              <Fragment set:html={entry.previewHTML} />
            </template>
          )}
        </li>
      ))
    }
  </ul>
</section>
