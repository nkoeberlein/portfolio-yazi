---
/**
 * Shell prompt atop opened documents: `user@host ~ $ cat file.md`.
 * The handle is loaded from `site.config.ts`.
 */
import { HANDLE } from "../site.config";

interface Props {
  /** The typed command, e.g. `cat cv.md` */
  cmd: string;
}

const { cmd } = Astro.props;
---

<p class="doc-prompt"><span class="cmd">{HANDLE} ~ $</span> {cmd}</p>
