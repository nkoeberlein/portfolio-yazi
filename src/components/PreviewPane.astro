---
/**
 * Right pane: displays the selected entry. The initial content comes
 * server-side (deep-linkable!) — via the `html` prop or slot. keynav.ts
 * swaps it via `<template>` and scrolls the body (`J/K`).
 */
interface Props {
  title: string;
  html?: string;
}

const { title, html = "" } = Astro.props;
---

<aside id="preview" class="pane" aria-label="Preview">
  <span id="preview-title" class="pane-title" aria-hidden="true">{title} </span>
  <div id="preview-body" class="pane-body">
    <slot>{html && <Fragment set:html={html} />}</slot>
  </div>
</aside>
