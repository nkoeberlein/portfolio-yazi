---
import "../styles/global.css";
import "../styles/tui.css";
import "../styles/list.css";
import "../styles/doc.css";
import "../styles/dialog.css";
import "../styles/fetch.css";
import "../styles/mermaid.css";
import "../styles/fx.css";
import ShortcutOverlay from "../components/ShortcutOverlay.astro";
import type { Status } from "../lib/panes";
import { HANDLE, SITE } from "../site.config";

export interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  /** Page part of the title (e.g. `cv.md`); the handle is appended automatically */
  title: string;
  description: string;
  /** Path relative to `~`; the handle crumb is injected by the shell */
  crumbs: Crumb[];
  /** "tree" = listing with interactive selection, "file" = opened document */
  kind: "tree" | "file";
  /** Route of the parent directory (for the `h` key) */
  parent?: string;
  /** Status line content for the active entry, see `statusOf()` */
  status: Status;
  /** Keep page out of search engines (e.g. legal pages) */
  noindex?: boolean;
}

const {
  title,
  description,
  crumbs,
  kind,
  parent = "",
  status,
  noindex = false,
} = Astro.props;

// Directory labels already end with `/` — do not add an extra separator there.
const SEP = '<span aria-hidden="true">/</span>';
const pageTitle = `${title} · ${HANDLE}`;
// SITE.url feeds astro.config `site`; fall back to the request origin in dev.
const base = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, base);
const ogImageURL = new URL("/og.png", base);
const path: Crumb[] = [{ label: HANDLE, href: "/" }, ...crumbs];
const crumb = path
  .map((c, i) => {
    const sep = i > 0 && !path[i - 1]?.label.endsWith("/") ? SEP : "";
    const last = i === path.length - 1;
    const body = last
      ? `<span class="cur">${c.label}</span>`
      : c.href
        ? `<a href="${c.href}">${c.label}</a>`
        : c.label;
    return sep + body;
  })
  .join("");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title={`~/blog — ${SITE.name}`} href="/blog/feed.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={HANDLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    {SITE.simpleAnalytics && (
      <script async src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    )}
  </head>
  <body>
    <div
      class="tui"
      data-kind={kind}
      data-parent={parent}
      data-home="/"
    >
      <header class="tui-head">
        <span class="crumb" set:html={crumb} />
        <span class="head-right" aria-hidden="true">
          <span>fl: sweet</span>
          <span class="seg seg-tab">1</span>
        </span>
      </header>

      <div class="panes">
        <slot />
      </div>

      <footer class="tui-foot">
        <div class="statusbar" aria-hidden="true">
          <span class="st-left">
            <span class="seg seg-mode">NOR</span>
            <span id="st-size" class="seg seg-size">{status.size}</span>
            <span id="st-name" class="st-name">{status.name}</span>
            <span id="st-note" class="st-note">{status.note}</span>
          </span>
          <span class="st-right">
            <span id="st-date" class="st-date">{status.date}</span>
            <span id="st-perms" class="st-perms">{status.perms}</span>
            <span id="st-pos" class="seg seg-pos">{status.pos}</span>
          </span>
        </div>
        <div class="keyhints">
          <span><b>↑/↓</b> move</span>
          <span><b>→/⏎</b> open</span>
          <span><b>←</b> up</span>
          <span class="wide"><b>g/G</b> ends</span>
          <span class="wide"><b>J/K</b> scroll preview</span>
          <span><b>q</b> home</span>
          <span><b>?</b> keys</span>
          <nav class="legal-links" aria-label="Legal">
            <a href="/legal/imprint/">imprint</a>
            <a href="/legal/privacy/">privacy</a>
          </nav>
        </div>
      </footer>
    </div>

    <ShortcutOverlay />
    <script src="../scripts/keynav.ts"></script>
  </body>
</html>
