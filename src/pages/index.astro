---
import FileList from "../components/FileList.astro";
import ParentPane from "../components/ParentPane.astro";
import PreviewPane from "../components/PreviewPane.astro";
import TUIShell from "../layouts/TUIShell.astro";
import { homeParent, statusOf } from "../lib/panes";
import { rootVMs } from "../lib/rootview";
import { SITE } from "../site.config";

const DEFAULT_HREF = "/welcome/";

const { entries } = await rootVMs(DEFAULT_HREF);
const preview = entries.find((entry) => entry.selected);
if (!preview) throw new Error("Root view needs exactly one selected entry");
---

<TUIShell
  title="~/"
  description={`Portfolio of ${SITE.name}, ${SITE.role.toLowerCase()} — as a terminal file manager.`}
  crumbs={[{ label: "~" }]}
  kind="tree"
  status={statusOf(entries)}
>
  <ParentPane entries={homeParent()} label="/home" />
  <FileList entries={entries} ariaLabel="Home directory" />
  <PreviewPane title={preview.previewTitle} html={preview.previewHTML} />
</TUIShell>