---
import { type CollectionEntry, getCollection } from "astro:content";
import FileList from "../../components/FileList.astro";
import ParentPane from "../../components/ParentPane.astro";
import PreviewPane from "../../components/PreviewPane.astro";
import Prompt from "../../components/Prompt.astro";
import TUIShell from "../../layouts/TUIShell.astro";
import { diagramVMs } from "../../lib/diagrams";
import { mermaidFigure } from "../../lib/mermaid";
import { rootParent, statusOf } from "../../lib/panes";

export async function getStaticPaths() {
  const diagrams = await getCollection("diagrams");
  return diagrams.map((entry) => ({ params: { slug: entry.id }, props: { entry, diagrams } }));
}

interface Props {
  entry: CollectionEntry<"diagrams">;
  diagrams: CollectionEntry<"diagrams">[];
}

const { entry, diagrams } = Astro.props;
const entries = diagramVMs(diagrams, entry.id, true);
const self = entries.find((vm) => vm.selected);
if (!self) throw new Error(`Self entry missing for ${entry.id}`);
---

<TUIShell
  title={self.name}
  description={entry.data.summary}
  crumbs={[
    { label: "~", href: "/" },
    { label: "diagrams/", href: "/diagrams/" },
    { label: self.name },
  ]}
  kind="file"
  parent="/diagrams/"
  status={statusOf(entries)}
>
  <ParentPane entries={rootParent("/diagrams/")} label="~" />
  <FileList entries={entries} ariaLabel="Diagrams directory" />
  <PreviewPane title={self.previewTitle}>
    <Prompt cmd={`cat ${self.name}`} />
    <article class="doc">
      <h1>{entry.data.title}</h1>
      <p>{entry.data.summary}</p>
      <Fragment set:html={mermaidFigure(entry.data.code, entry.data.title)} />
      <h2>source</h2>
      <p>
        Put this into a <code>```mermaid</code> block in any Markdown file of the site — it is
        rendered to SVG at build time, no JavaScript in the browser.
      </p>
      <pre><code>{entry.data.code}</code></pre>
    </article>
  </PreviewPane>
</TUIShell>
